rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------
    // Auth + role helpers
    // -----------------------------------------------------------------

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function currentUserDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserExists() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isActiveAccount() {
      return currentUserExists() &&
        currentUserDoc().data.get("accountStatus", "active") == "active";
    }

    function isAdmin() {
      return currentUserExists() &&
        currentUserDoc().data.isAdmin == true &&
        currentUserDoc().data.get("accountStatus", "active") == "active";
    }

    function isOwner() {
      return currentUserExists() &&
        currentUserDoc().data.isOwner == true &&
        currentUserDoc().data.get("accountStatus", "active") == "active";
    }

    function isAdminOrOwner() {
      return isAdmin() || isOwner();
    }

    function isApprovedVendor() {
      return currentUserExists() &&
        (
          currentUserDoc().data.vendorStatus == "approved" ||
          currentUserDoc().data.get("isVendor", false) == true ||
          currentUserDoc().data.get("vendor", false) == true ||
          currentUserDoc().data.get("roles", {}).get("vendor", false) == true
        ) &&
        currentUserDoc().data.get("accountStatus", "active") == "active";
    }

    function canManageOwnVendorResources(userId) {
      return isSelf(userId) &&
        isActiveAccount() &&
        (
          isApprovedVendor() ||
          isAdminOrOwner()
        );
    }

    // -----------------------------------------------------------------
    // Order helpers
    // -----------------------------------------------------------------

    function orderDoc(orderId) {
      return get(/databases/$(database)/documents/orders/$(orderId));
    }

    function orderExists(orderId) {
      return exists(/databases/$(database)/documents/orders/$(orderId));
    }

    function isOrderParticipantById(orderId) {
      return signedIn() &&
        orderExists(orderId) &&
        (
          orderDoc(orderId).data.customerUid == request.auth.uid ||
          orderDoc(orderId).data.vendorUid == request.auth.uid ||
          isAdminOrOwner()
        );
    }

    function isOrderCustomer() {
      return signedIn() && resource.data.customerUid == request.auth.uid;
    }

    function isOrderVendor() {
      return signedIn() && resource.data.vendorUid == request.auth.uid;
    }

    function isOrderParticipant() {
      return isOrderCustomer() || isOrderVendor() || isAdminOrOwner();
    }

    function orderUpdateAffectsOnlyAllowedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "orderId",
        "status",
        "timeline",
        "notes",
        "updatedAt",
        "customerConfirmedCollected",
        "vendorConfirmedCollected",
        "paymentId",
        "paymentStatus",
        "paymentProvider",
        "paymentReference",
        "paymentAccessCode",
        "paymentAuthorizationUrl",
        "paymentAmount",
        "paymentAmountInMinorUnits",
        "paymentCurrency",
        "paymentPaidAt",
        "paymentFailedAt",
        "paymentVerifiedAt",
        "paymentFailureReason",
        "refundStatus",
        "refundReference",
        "refundAmount",
        "refundAmountInMinorUnits",
        "refundReason",
        "refundRequestedAt",
        "refundProcessedAt",
        "refundedAt",
        "refundFailureReason"
      ]);
    }

    function paymentUpdateAffectsOnlyPaymentKeys() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "updatedAt",
        "paymentId",
        "paymentStatus",
        "paymentProvider",
        "paymentReference",
        "paymentAccessCode",
        "paymentAuthorizationUrl",
        "paymentAmount",
        "paymentAmountInMinorUnits",
        "paymentCurrency",
        "paymentPaidAt",
        "paymentFailedAt",
        "paymentVerifiedAt",
        "paymentFailureReason"
      ]);
    }

    function orderImmutableFieldsPreserved() {
      return request.resource.data.customerUid == resource.data.customerUid &&
        request.resource.data.vendorUid == resource.data.vendorUid &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    function customerConfirmationPreservedOrAdvanced() {
      return !("customerConfirmedCollected" in request.resource.data) ||
        request.resource.data.customerConfirmedCollected == resource.data.get("customerConfirmedCollected", false) ||
        (
          resource.data.get("customerConfirmedCollected", false) == false &&
          request.resource.data.customerConfirmedCollected == true
        );
    }

    function vendorConfirmationPreservedOrAdvanced() {
      return !("vendorConfirmedCollected" in request.resource.data) ||
        request.resource.data.vendorConfirmedCollected == resource.data.get("vendorConfirmedCollected", false) ||
        (
          resource.data.get("vendorConfirmedCollected", false) == false &&
          request.resource.data.vendorConfirmedCollected == true
        );
    }

    function customerOnlyTouchesOwnConfirmation() {
      return !("vendorConfirmedCollected" in request.resource.data) ||
        request.resource.data.vendorConfirmedCollected == resource.data.get("vendorConfirmedCollected", false);
    }

    function vendorOnlyTouchesOwnConfirmation() {
      return !("customerConfirmedCollected" in request.resource.data) ||
        request.resource.data.customerConfirmedCollected == resource.data.get("customerConfirmedCollected", false);
    }

    function vendorDoesNotTouchPaymentFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        "paymentId",
        "paymentStatus",
        "paymentProvider",
        "paymentReference",
        "paymentAccessCode",
        "paymentAuthorizationUrl",
        "paymentAmount",
        "paymentAmountInMinorUnits",
        "paymentCurrency",
        "paymentPaidAt",
        "paymentFailedAt",
        "paymentVerifiedAt",
        "paymentFailureReason",
        "refundStatus",
        "refundReference",
        "refundAmount",
        "refundAmountInMinorUnits",
        "refundReason",
        "refundRequestedAt",
        "refundProcessedAt",
        "refundFailureReason"
      ]);
    }

    function vendorIsRejectingPaidOrderToRefunded() {
      return resource.data.paymentStatus == "paid" &&
        request.resource.data.status == "rejected" &&
        request.resource.data.paymentStatus == "refunded" &&
        request.resource.data.refundStatus == "refunded" &&
        request.resource.data.paymentReference == resource.data.paymentReference &&
        request.resource.data.paymentAmount == resource.data.paymentAmount &&
        request.resource.data.paymentAmountInMinorUnits == resource.data.paymentAmountInMinorUnits &&
        request.resource.data.paymentCurrency == resource.data.paymentCurrency &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          "paymentId",
          "paymentProvider",
          "paymentAccessCode",
          "paymentAuthorizationUrl",
          "paymentPaidAt",
          "paymentFailedAt",
          "paymentVerifiedAt",
          "paymentFailureReason"
        ]);
    }

    function isValidOrderCreate() {
      return signedIn() &&
        isActiveAccount() &&
        request.resource.data.customerUid == request.auth.uid &&
        request.resource.data.customerUid is string &&
        request.resource.data.vendorUid is string &&
        request.resource.data.vendorUid != "" &&
        request.resource.data.status == "pending" &&
        // Recommendation metadata such as dietary/allergens is stored inside
        // each item. The rule validates the item collection shape here, while
        // the app model validates and normalises the item fields themselves.
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.get("vendorSubtotal", 0) >= 0 &&
        request.resource.data.get("vendorEarnings", 0) >= 0 &&
        request.resource.data.get("platformFee", 0) >= 0 &&
        request.resource.data.get("platformEarnings", 0) >= 0 &&
        request.resource.data.get("customerTotal", 0) >= 0 &&
        (
          !("financeModel" in request.resource.data) ||
          request.resource.data.financeModel == "vendor-price-plus-platform-fee"
        ) &&
        request.resource.data.paymentStatus == "paid" &&
        request.resource.data.paymentReference is string &&
        request.resource.data.paymentReference != "" &&
        request.resource.data.get("customerConfirmedCollected", false) == false &&
        request.resource.data.get("vendorConfirmedCollected", false) == false;
    }

    function isValidOrderUpdate() {
      return isOrderParticipant() &&
        orderUpdateAffectsOnlyAllowedKeys() &&
        orderImmutableFieldsPreserved() &&
        customerConfirmationPreservedOrAdvanced() &&
        vendorConfirmationPreservedOrAdvanced() &&
        (
          isAdminOrOwner() ||
          (
            isOrderCustomer() &&
            (
              customerOnlyTouchesOwnConfirmation() ||
              paymentUpdateAffectsOnlyPaymentKeys()
            )
          ) ||
          (
            isOrderVendor() &&
            vendorOnlyTouchesOwnConfirmation() &&
            (
              vendorDoesNotTouchPaymentFields() ||
              vendorIsRejectingPaidOrderToRefunded()
            )
          )
        );
    }

    // -----------------------------------------------------------------
    // Checkout session helpers
    // -----------------------------------------------------------------

    function isCheckoutCustomer() {
      return signedIn() && resource.data.customerUid == request.auth.uid;
    }

    function checkoutCreateAffectsOnlyAllowedKeys() {
      return request.resource.data.keys().hasOnly([
        "checkoutId",
        "customerUid",
        "customerName",
        "customerEmail",
        "vendorUid",
        "vendorName",
        "items",
        "itemCount",
        "subtotal",
        "total",
        "vendorSubtotal",
        "vendorEarnings",
        "platformFeeRate",
        "platformFee",
        "platformEarnings",
        "customerTotal",
        "financeModel",
        "status",
        "paymentProvider",
        "paymentReference",
        "paymentAccessCode",
        "paymentAuthorizationUrl",
        "paymentAmount",
        "paymentAmountInMinorUnits",
        "paymentCurrency",
        "paymentPaidAt",
        "paymentFailedAt",
        "paymentVerifiedAt",
        "paymentFailureReason",
        "convertedOrderId",
        "convertedAt",
        "cancelledAt",
        "expiredAt",
        "refundStatus",
        "refundReference",
        "metadata",
        "timeline",
        "notes",
        "createdAt",
        "updatedAt"
      ]);
    }

    function checkoutUpdateAffectsOnlyCustomerKeys() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "status",
        "paymentProvider",
        "paymentReference",
        "paymentAccessCode",
        "paymentAuthorizationUrl",
        "paymentAmount",
        "paymentAmountInMinorUnits",
        "paymentCurrency",
        "paymentFailedAt",
        "paymentFailureReason",
        "cancelledAt",
        "expiredAt",
        "metadata",
        "timeline",
        "notes",
        "updatedAt"
      ]);
    }

    function checkoutImmutableFieldsPreserved() {
      return request.resource.data.customerUid == resource.data.customerUid &&
        request.resource.data.vendorUid == resource.data.vendorUid &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.items == resource.data.items &&
        request.resource.data.subtotal == resource.data.subtotal &&
        request.resource.data.total == resource.data.total &&
        request.resource.data.get("vendorSubtotal", 0) == resource.data.get("vendorSubtotal", 0) &&
        request.resource.data.get("vendorEarnings", 0) == resource.data.get("vendorEarnings", 0) &&
        request.resource.data.get("platformFeeRate", 0) == resource.data.get("platformFeeRate", 0) &&
        request.resource.data.get("platformFee", 0) == resource.data.get("platformFee", 0) &&
        request.resource.data.get("platformEarnings", 0) == resource.data.get("platformEarnings", 0) &&
        request.resource.data.get("customerTotal", 0) == resource.data.get("customerTotal", 0) &&
        request.resource.data.get("financeModel", "") == resource.data.get("financeModel", "");
    }

    function checkoutClientWritableStatus(status) {
      return status == "draft" ||
        status == "payment_pending" ||
        status == "payment_failed" ||
        status == "cancelled" ||
        status == "expired";
    }

    function checkoutIsNotServerFinalised() {
      return resource.data.get("status", "") != "paid" &&
        resource.data.get("status", "") != "converted";
    }

    function checkoutServerOnlyFieldsAreEmptyOnCreate() {
      return request.resource.data.get("paymentPaidAt", null) == null &&
        request.resource.data.get("paymentVerifiedAt", null) == null &&
        request.resource.data.get("convertedOrderId", "") == "" &&
        request.resource.data.get("convertedAt", null) == null &&
        request.resource.data.get("refundStatus", "") == "" &&
        request.resource.data.get("refundReference", "") == "";
    }

    function checkoutServerOnlyFieldsPreserved() {
      return request.resource.data.get("paymentPaidAt", null) == resource.data.get("paymentPaidAt", null) &&
        request.resource.data.get("paymentVerifiedAt", null) == resource.data.get("paymentVerifiedAt", null) &&
        request.resource.data.get("convertedOrderId", "") == resource.data.get("convertedOrderId", "") &&
        request.resource.data.get("convertedAt", null) == resource.data.get("convertedAt", null) &&
        request.resource.data.get("refundStatus", "") == resource.data.get("refundStatus", "") &&
        request.resource.data.get("refundReference", "") == resource.data.get("refundReference", "");
    }

    function isValidCheckoutCreate() {
      return signedIn() &&
        isActiveAccount() &&
        checkoutCreateAffectsOnlyAllowedKeys() &&
        request.resource.data.customerUid == request.auth.uid &&
        request.resource.data.customerUid is string &&
        request.resource.data.vendorUid is string &&
        request.resource.data.vendorUid != "" &&
        request.resource.data.status is string &&
        checkoutClientWritableStatus(request.resource.data.status) &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.createdAt != null &&
        checkoutServerOnlyFieldsAreEmptyOnCreate();
    }

    function isValidCheckoutCustomerUpdate() {
      return isCheckoutCustomer() &&
        isActiveAccount() &&
        checkoutIsNotServerFinalised() &&
        checkoutUpdateAffectsOnlyCustomerKeys() &&
        checkoutImmutableFieldsPreserved() &&
        checkoutServerOnlyFieldsPreserved() &&
        request.resource.data.status is string &&
        checkoutClientWritableStatus(request.resource.data.status);
    }

    // -----------------------------------------------------------------
    // Payout helpers
    // -----------------------------------------------------------------

    function isPayoutOwner() {
      return signedIn() && resource.data.vendorUid == request.auth.uid;
    }

    function payoutStatusIsValid(status) {
      return status == "pending" ||
        status == "approved" ||
        status == "paid" ||
        status == "rejected" ||
        status == "cancelled";
    }

    function payoutCreateAffectsOnlyAllowedKeys() {
      return request.resource.data.keys().hasOnly([
        "payoutId",
        "vendorUid",
        "vendorName",
        "vendorEmail",
        "amount",
        "amountInMinorUnits",
        "currency",
        "status",
        "statusLabel",
        "fakeBankName",
        "fakeAccountHolder",
        "fakeAccountNumberLast4",
        "fakeAccountNumberMasked",
        "fakeBranchCode",
        "fakeAccountType",
        "requestedAt",
        "approvedAt",
        "paidAt",
        "rejectedAt",
        "cancelledAt",
        "processedAt",
        "processedByUid",
        "processedByName",
        "rejectionReason",
        "notes",
        "testMode",
        "testEmailQueued",
        "emailNotificationId",
        "timeline",
        "createdAt",
        "updatedAt"
      ]);
    }

    function payoutUpdateAffectsOnlyAllowedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "status",
        "statusLabel",
        "approvedAt",
        "paidAt",
        "rejectedAt",
        "cancelledAt",
        "processedAt",
        "processedByUid",
        "processedByName",
        "rejectionReason",
        "testEmailQueued",
        "emailNotificationId",
        "timeline",
        "updatedAt"
      ]);
    }

    function vendorPayoutCancelAffectsOnlyAllowedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "status",
        "statusLabel",
        "cancelledAt",
        "timeline",
        "updatedAt"
      ]);
    }

    function isValidPayoutCreate() {
      return signedIn() &&
        isApprovedVendor() &&
        payoutCreateAffectsOnlyAllowedKeys() &&
        request.resource.data.vendorUid == request.auth.uid &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0 &&
        request.resource.data.amountInMinorUnits is int &&
        request.resource.data.amountInMinorUnits > 0 &&
        request.resource.data.currency is string &&
        request.resource.data.currency != "" &&
        request.resource.data.status == "pending" &&
        request.resource.data.statusLabel == "Pending" &&
        request.resource.data.fakeBankName is string &&
        request.resource.data.fakeBankName != "" &&
        request.resource.data.fakeAccountHolder is string &&
        request.resource.data.fakeAccountHolder != "" &&
        request.resource.data.fakeAccountNumberLast4 is string &&
        request.resource.data.fakeAccountNumberLast4.size() <= 4 &&
        request.resource.data.fakeAccountNumberMasked is string &&
        request.resource.data.fakeBranchCode is string &&
        request.resource.data.fakeBranchCode != "" &&
        request.resource.data.fakeAccountType is string &&
        request.resource.data.testMode == true &&
        request.resource.data.testEmailQueued is bool &&
        request.resource.data.timeline is list &&
        request.resource.data.timeline.size() > 0 &&
        request.resource.data.createdAt != null &&
        request.resource.data.updatedAt != null &&
        request.resource.data.requestedAt != null;
    }

    function isValidPayoutUpdate() {
      return signedIn() &&
        payoutUpdateAffectsOnlyAllowedKeys() &&
        payoutStatusIsValid(request.resource.data.status) &&
        (
          isAdminOrOwner() ||
          (
            isPayoutOwner() &&
            resource.data.status == "pending" &&
            request.resource.data.status == "cancelled" &&
            request.resource.data.statusLabel == "Cancelled" &&
            vendorPayoutCancelAffectsOnlyAllowedKeys()
          )
        );
    }

    // -----------------------------------------------------------------
    // Support ticket helpers
    // -----------------------------------------------------------------

    function supportTicketDoc(ticketId) {
      return get(/databases/$(database)/documents/supportTickets/$(ticketId));
    }

    function supportTicketExists(ticketId) {
      return exists(/databases/$(database)/documents/supportTickets/$(ticketId));
    }

    function isTicketReporter() {
      return signedIn() && resource.data.reporterUid == request.auth.uid;
    }

    function isTicketLinkedParty() {
      return signedIn() && (
        resource.data.get("customerUid", "") == request.auth.uid ||
        resource.data.get("vendorUid", "") == request.auth.uid
      );
    }

    function isTicketCustomerParty() {
      return signedIn() && resource.data.get("customerUid", "") == request.auth.uid;
    }

    function isTicketVendorParty() {
      return signedIn() && resource.data.get("vendorUid", "") == request.auth.uid;
    }

    function isTicketParticipant() {
      return isTicketReporter() || isTicketLinkedParty() || isAdminOrOwner();
    }

    function isTicketParticipantById(ticketId) {
      return signedIn() &&
        supportTicketExists(ticketId) &&
        (
          supportTicketDoc(ticketId).data.reporterUid == request.auth.uid ||
          supportTicketDoc(ticketId).data.get("customerUid", "") == request.auth.uid ||
          supportTicketDoc(ticketId).data.get("vendorUid", "") == request.auth.uid ||
          isAdminOrOwner()
        );
    }

    function isValidTicketCreate() {
      return signedIn() &&
        isActiveAccount() &&
        request.resource.data.reporterUid == request.auth.uid &&
        request.resource.data.reporterUid is string &&
        (
          request.resource.data.reporterRole == "customer" ||
          request.resource.data.reporterRole == "vendor"
        ) &&
        request.resource.data.subject is string &&
        request.resource.data.subject.size() > 0 &&
        request.resource.data.description is string &&
        request.resource.data.description.size() > 0 &&
        request.resource.data.category is string &&
        request.resource.data.status == "open" &&
        request.resource.data.get("replyCount", 0) == 0 &&
        request.resource.data.get("resolvedAt", null) == null &&
        // Refund cases are created by admins after a support ticket is opened.
        // Reporters can ask for a refund via category/order context, but they
        // cannot seed proposed, approved, processing, or completed refund state.
        request.resource.data.get("refundCase", null) == null &&
        (
          !("orderId" in request.resource.data) ||
          request.resource.data.orderId == "" ||
          isOrderParticipantById(request.resource.data.orderId)
        );
    }

    function ticketImmutableFieldsPreserved() {
      return request.resource.data.ticketId == resource.data.ticketId &&
        request.resource.data.reporterUid == resource.data.reporterUid &&
        request.resource.data.reporterRole == resource.data.reporterRole &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.subject == resource.data.subject &&
        request.resource.data.description == resource.data.description &&
        request.resource.data.category == resource.data.category &&
        request.resource.data.get("orderId", "") == resource.data.get("orderId", "") &&
        request.resource.data.get("customerUid", "") == resource.data.get("customerUid", "") &&
        request.resource.data.get("vendorUid", "") == resource.data.get("vendorUid", "");
    }

    function ticketUpdateAffectsOnlyAllowedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "status",
        "statusLabel",
        "priority",
        "replyCount",
        "lastReplyAt",
        "resolvedAt",
        "resolvedByUid",
        "resolvedByName",
        "resolutionNote",
        "refundCase",
        "timeline",
        "updatedAt",
        "categoryLabel"
      ]);
    }

    function participantTicketUpdateAffectsOnlyParticipantKeys() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "status",
        "statusLabel",
        "replyCount",
        "lastReplyAt",
        "refundCase",
        "timeline",
        "updatedAt"
      ]);
    }

    function participantStatusChangeIsAllowed() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["status"]) ||
        (
          request.resource.data.status == "open" ||
          request.resource.data.status == "in_progress" ||
          request.resource.data.status == "awaiting_user" ||
          request.resource.data.status == "closed"
        );
    }

    function refundCaseCoreFieldsPreserved() {
      return request.resource.data.refundCase.get("ticketId", "") == resource.data.refundCase.get("ticketId", "") &&
        request.resource.data.refundCase.get("orderId", "") == resource.data.refundCase.get("orderId", "") &&
        request.resource.data.refundCase.get("customerUid", "") == resource.data.refundCase.get("customerUid", "") &&
        request.resource.data.refundCase.get("vendorUid", "") == resource.data.refundCase.get("vendorUid", "") &&
        request.resource.data.refundCase.get("type", "") == resource.data.refundCase.get("type", "") &&
        request.resource.data.refundCase.get("amount", 0) == resource.data.refundCase.get("amount", 0) &&
        request.resource.data.refundCase.get("amountInMinorUnits", 0) == resource.data.refundCase.get("amountInMinorUnits", 0) &&
        request.resource.data.refundCase.get("currency", "") == resource.data.refundCase.get("currency", "") &&
        request.resource.data.refundCase.get("reason", "") == resource.data.refundCase.get("reason", "") &&
        request.resource.data.refundCase.get("proposedByUid", "") == resource.data.refundCase.get("proposedByUid", "") &&
        request.resource.data.refundCase.get("proposedAt", null) == resource.data.refundCase.get("proposedAt", null) &&
        request.resource.data.refundCase.get("createdAt", null) == resource.data.refundCase.get("createdAt", null);
    }

    function refundCaseParticipantDecisionStatusIsAllowed() {
      return request.resource.data.refundCase.get("status", "") == "customer_approved" ||
        request.resource.data.refundCase.get("status", "") == "vendor_approved" ||
        request.resource.data.refundCase.get("status", "") == "approved" ||
        request.resource.data.refundCase.get("status", "") == "declined";
    }

    function customerRefundCaseDecisionKeysAreAllowed() {
      return request.resource.data.refundCase.diff(resource.data.refundCase).affectedKeys().hasOnly([
        "status",
        "statusLabel",
        "customerDecision",
        "customerDecidedAt",
        "customerNote",
        "timeline",
        "updatedAt"
      ]);
    }

    function vendorRefundCaseDecisionKeysAreAllowed() {
      return request.resource.data.refundCase.diff(resource.data.refundCase).affectedKeys().hasOnly([
        "status",
        "statusLabel",
        "vendorDecision",
        "vendorDecidedAt",
        "vendorNote",
        "timeline",
        "updatedAt"
      ]);
    }

    function participantRefundCaseUpdateIsAllowed() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(["refundCase"]) ||
        (
          resource.data.refundCase is map &&
          request.resource.data.refundCase is map &&
          refundCaseCoreFieldsPreserved() &&
          refundCaseParticipantDecisionStatusIsAllowed() &&
          (
            (
              isTicketCustomerParty() &&
              customerRefundCaseDecisionKeysAreAllowed() &&
              request.resource.data.refundCase.get("customerDecision", "") in ["approved", "declined"] &&
              request.resource.data.refundCase.get("vendorDecision", "") == resource.data.refundCase.get("vendorDecision", "pending")
            ) ||
            (
              isTicketVendorParty() &&
              vendorRefundCaseDecisionKeysAreAllowed() &&
              request.resource.data.refundCase.get("vendorDecision", "") in ["approved", "declined"] &&
              request.resource.data.refundCase.get("customerDecision", "") == resource.data.refundCase.get("customerDecision", "pending")
            )
          )
        );
    }

    function isValidTicketUpdate() {
      return signedIn() &&
        ticketUpdateAffectsOnlyAllowedKeys() &&
        ticketImmutableFieldsPreserved() &&
        (
          isAdminOrOwner() ||
          (
            isTicketParticipant() &&
            participantTicketUpdateAffectsOnlyParticipantKeys() &&
            participantStatusChangeIsAllowed() &&
            participantRefundCaseUpdateIsAllowed()
          )
        );
    }

    // -----------------------------------------------------------------
    // Notification helpers
    // -----------------------------------------------------------------

    function isNotificationRecipientData(data) {
      return signedIn() && request.auth.uid == data.recipientUid;
    }

    // -----------------------------------------------------------------
    // Application self-submission helpers
    // -----------------------------------------------------------------

    function isOwnPendingVendorSubmission(before, after) {
      let oldStatus = before.vendorStatus;
      let newStatus = after.vendorStatus;

      return (
        oldStatus == newStatus ||
        (
          (oldStatus == "none" || oldStatus == "rejected") &&
          newStatus == "pending" &&
          after.vendorReason == ""
        )
      );
    }

    function isOwnPendingAdminSubmission(before, after) {
      let oldStatus = before.adminApplicationStatus;
      let newStatus = after.adminApplicationStatus;

      return (
        oldStatus == newStatus ||
        (
          before.isAdmin == false &&
          (oldStatus == "none" || oldStatus == "rejected") &&
          newStatus == "pending" &&
          after.isAdmin == false &&
          after.adminApplicationReason == ""
        )
      );
    }

    function selfCanUpdateOwnProfile(userId) {
      return isSelf(userId) &&
        request.resource.data.uid == userId &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.isAdmin == resource.data.isAdmin &&
        request.resource.data.accountStatus == resource.data.accountStatus &&
        isOwnPendingVendorSubmission(resource.data, request.resource.data) &&
        isOwnPendingAdminSubmission(resource.data, request.resource.data);
    }

    function validApplicationOwner(docId) {
      return signedIn() &&
        request.auth.uid == docId &&
        request.resource.data.uid == request.auth.uid;
    }

    // -----------------------------------------------------------------
    // /users + /users/{uid}/menuItems
    // -----------------------------------------------------------------

    match /users/{userId} {
      allow create: if isSelf(userId) &&
        request.resource.data.uid == userId;

      allow get, list: if signedIn();

      allow update: if isAdminOrOwner() || selfCanUpdateOwnProfile(userId);

      allow delete: if isSelf(userId) || isAdminOrOwner();

      match /menuItems/{productId} {
        allow get, list: if signedIn();

        allow create: if canManageOwnVendorResources(userId) &&
          request.resource.data.vendorUid == userId;

        allow update: if canManageOwnVendorResources(userId) &&
          request.resource.data.vendorUid == userId &&
          request.resource.data.createdAt == resource.data.createdAt;

        allow delete: if canManageOwnVendorResources(userId);
      }
    }

    // -----------------------------------------------------------------
    // /vendorApplications, /adminApplications
    // -----------------------------------------------------------------

    match /vendorApplications/{userId} {
      allow get: if isSelf(userId) || isAdminOrOwner();
      allow list: if isAdminOrOwner();

      allow create, update: if (
        validApplicationOwner(userId) &&
        request.resource.data.vendorStatus == "pending" &&
        request.resource.data.vendorReason == ""
      ) || isAdminOrOwner();

      allow delete: if isAdminOrOwner();
    }

    match /adminApplications/{userId} {
      allow get: if isSelf(userId) || isAdminOrOwner();
      allow list: if isAdminOrOwner();

      allow create, update: if (
        validApplicationOwner(userId) &&
        request.resource.data.isAdmin == false &&
        request.resource.data.adminApplicationStatus == "pending" &&
        request.resource.data.adminApplicationReason == ""
      ) || isAdminOrOwner();

      allow delete: if isAdminOrOwner();
    }

    // -----------------------------------------------------------------
    // /checkoutSessions
    // -----------------------------------------------------------------

    match /checkoutSessions/{checkoutId} {
      allow create: if isValidCheckoutCreate() || isAdminOrOwner();

      allow get, list: if signedIn() &&
        resource.data.customerUid == request.auth.uid;
      allow get, list: if signedIn() &&
        resource.data.vendorUid == request.auth.uid;
      allow get, list: if isAdminOrOwner();

      allow update: if isValidCheckoutCustomerUpdate() || isAdminOrOwner();

      allow delete: if isAdminOrOwner();
    }

    // -----------------------------------------------------------------
    // /orders
    // -----------------------------------------------------------------

    match /orders/{orderId} {
      allow create: if isValidOrderCreate();

      allow get, list: if signedIn() &&
        resource.data.customerUid == request.auth.uid;

      allow get, list: if signedIn() &&
        resource.data.vendorUid == request.auth.uid;

      allow get, list: if isAdminOrOwner();

      allow update: if isValidOrderUpdate();

      allow delete: if isAdminOrOwner();
    }

    // -----------------------------------------------------------------
    // /payouts
    //
    // This is the collection used by the updated vendor wallet.js.
    // Vendors can only create and read their own payout requests.
    // Admins/owners can read, process, and delete payout requests.
    // -----------------------------------------------------------------

    match /payouts/{payoutId} {
      allow create: if isValidPayoutCreate() || isAdminOrOwner();

      allow get, list: if signedIn() &&
        resource.data.vendorUid == request.auth.uid;

      allow get, list: if isAdminOrOwner();

      allow update: if isValidPayoutUpdate();

      allow delete: if isAdminOrOwner();
    }

    // -----------------------------------------------------------------
    // /payoutRequests
    //
    // Kept for backwards compatibility in case old code still reads/writes
    // payoutRequests. New wallet.js should use /payouts.
    // -----------------------------------------------------------------

    match /payoutRequests/{payoutId} {
      allow create: if isValidPayoutCreate() || isAdminOrOwner();

      allow get, list: if signedIn() &&
        resource.data.vendorUid == request.auth.uid;

      allow get, list: if isAdminOrOwner();

      allow update: if isValidPayoutUpdate();

      allow delete: if isAdminOrOwner();
    }

    // -----------------------------------------------------------------
    // /withdrawalRequests
    //
    // Optional compatibility alias in case any older page used this name.
    // -----------------------------------------------------------------

    match /withdrawalRequests/{payoutId} {
      allow create: if isValidPayoutCreate() || isAdminOrOwner();

      allow get, list: if signedIn() &&
        resource.data.vendorUid == request.auth.uid;

      allow get, list: if isAdminOrOwner();

      allow update: if isValidPayoutUpdate();

      allow delete: if isAdminOrOwner();
    }

    // -----------------------------------------------------------------
    // /supportTickets + /supportTickets/{id}/replies
    // -----------------------------------------------------------------

    match /supportTickets/{ticketId} {
      allow create: if isValidTicketCreate();

      allow get: if isTicketParticipant();
      allow list: if signedIn();

      allow update: if isValidTicketUpdate();

      allow delete: if isAdminOrOwner();

      match /replies/{replyId} {

        function isValidReplyCreate() {
          return signedIn() &&
            isActiveAccount() &&
            isTicketParticipantById(ticketId) &&
            request.resource.data.authorUid == request.auth.uid &&
            request.resource.data.ticketId == ticketId &&
            request.resource.data.body is string &&
            request.resource.data.body.size() > 0 &&
            (
              request.resource.data.authorRole == "customer" ||
              request.resource.data.authorRole == "vendor" ||
              request.resource.data.authorRole == "admin"
            ) &&
            (
              request.resource.data.get("isInternalNote", false) == false ||
              (request.resource.data.authorRole == "admin" && isAdminOrOwner())
            ) &&
            (
              request.resource.data.createdAt is timestamp ||
              request.resource.data.createdAt is string
            );
        }

        function isReplyVisible() {
          return isTicketParticipantById(ticketId) &&
            (
              resource.data.get("isInternalNote", false) == false ||
              isAdminOrOwner()
            );
        }

        allow create: if isValidReplyCreate();
        allow read: if isReplyVisible();
        allow update, delete: if isAdminOrOwner();
      }
    }

    // -----------------------------------------------------------------
    // /vendorReviews
    //
    // Customers leave one review per completed order via a composite ID
    // (`{orderId}_{customerUid}`). Anyone signed in can read reviews so that
    // averages can be shown on browse-vendors / browse-menu / shop pages.
    // -----------------------------------------------------------------

    function isReviewedOrderCustomer(orderId) {
      // Tightly couple a review to an actual order the customer placed.
      return signedIn() &&
        exists(/databases/$(database)/documents/orders/$(orderId)) &&
        get(/databases/$(database)/documents/orders/$(orderId)).data.customerUid == request.auth.uid &&
        get(/databases/$(database)/documents/orders/$(orderId)).data.status == "completed";
    }

    function isValidReviewSubmission() {
      return signedIn() &&
        isActiveAccount() &&
        request.resource.data.customerUid == request.auth.uid &&
        request.resource.data.orderId is string &&
        request.resource.data.orderId.size() > 0 &&
        request.resource.data.vendorUid is string &&
        request.resource.data.vendorUid.size() > 0 &&
        request.resource.data.vendorRating is int &&
        request.resource.data.vendorRating >= 1 &&
        request.resource.data.vendorRating <= 5 &&
        (
          !("vendorComment" in request.resource.data) ||
          (request.resource.data.vendorComment is string && request.resource.data.vendorComment.size() <= 500)
        ) &&
        (
          !("itemRatings" in request.resource.data) ||
          request.resource.data.itemRatings is list
        ) &&
        (
          !("isAnonymous" in request.resource.data) ||
          request.resource.data.isAnonymous is bool
        );
    }

    function reviewImmutableFieldsPreserved() {
      return request.resource.data.customerUid == resource.data.customerUid &&
        request.resource.data.orderId == resource.data.orderId &&
        request.resource.data.vendorUid == resource.data.vendorUid;
    }

    match /vendorReviews/{reviewId} {
      allow get, list: if signedIn();

      allow create: if isValidReviewSubmission() &&
        isReviewedOrderCustomer(request.resource.data.orderId);

      allow update: if signedIn() &&
        isActiveAccount() &&
        resource.data.customerUid == request.auth.uid &&
        isValidReviewSubmission() &&
        reviewImmutableFieldsPreserved();

      allow delete: if isAdmin() ||
        (signedIn() && resource.data.customerUid == request.auth.uid);
    }

    // -----------------------------------------------------------------
    // /notifications
    // -----------------------------------------------------------------

    match /notifications/{notificationId} {

      function validReadFlagOnCreate() {
        return
          (
            ("read" in request.resource.data && request.resource.data.read is bool) ||
            ("isRead" in request.resource.data && request.resource.data.isRead is bool)
          );
      }

      function isUnreadOnCreate() {
        return
          (
            ("read" in request.resource.data && request.resource.data.read == false) ||
            ("isRead" in request.resource.data && request.resource.data.isRead == false)
          );
      }

      function isValidNotificationCreation() {
        return signedIn() &&
          isActiveAccount() &&
          request.resource.data.recipientUid is string &&
          request.resource.data.recipientUid != "" &&
          request.resource.data.recipientRole is string &&
          request.resource.data.type is string &&
          request.resource.data.title is string &&
          request.resource.data.message is string &&
          validReadFlagOnCreate() &&
          isUnreadOnCreate() &&
          (
            request.resource.data.createdAt is timestamp ||
            request.resource.data.createdAt is string
          ) &&
          (
            !("updatedAt" in request.resource.data) ||
            request.resource.data.updatedAt is timestamp ||
            request.resource.data.updatedAt is string
          ) &&
          (!("orderId" in request.resource.data) || request.resource.data.orderId is string) &&
          (!("vendorUid" in request.resource.data) || request.resource.data.vendorUid is string) &&
          (!("customerUid" in request.resource.data) || request.resource.data.customerUid is string);
      }

      function canCreateNotification() {
        return isValidNotificationCreation() &&
          (
            !("orderId" in request.resource.data) ||
            request.resource.data.orderId == "" ||
            isOrderParticipantById(request.resource.data.orderId) ||
            request.resource.data.recipientUid == request.auth.uid ||
            isAdminOrOwner()
          );
      }

      function canUpdateNotification() {
        return isNotificationRecipientData(resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "read",
            "isRead",
            "updatedAt"
          ]) &&
          (!("read" in request.resource.data) || request.resource.data.read is bool) &&
          (!("isRead" in request.resource.data) || request.resource.data.isRead is bool) &&
          (
            !("updatedAt" in request.resource.data) ||
            request.resource.data.updatedAt is timestamp ||
            request.resource.data.updatedAt is string
          );
      }

      allow create: if canCreateNotification();

      allow read: if signedIn() && request.auth.uid == resource.data.recipientUid;
      allow read: if isAdminOrOwner();

      allow update: if canUpdateNotification();

      allow delete: if signedIn() && request.auth.uid == resource.data.recipientUid;
      allow delete: if isAdminOrOwner();
    }

    // -----------------------------------------------------------------
    // Catch-all: deny everything else by default
    // -----------------------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

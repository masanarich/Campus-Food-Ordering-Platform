# Paystack test mode keys.
# Never commit real values in .env.
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_test_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_replace_with_your_test_public_key

# Payment settings.
PAYSTACK_CURRENCY=ZAR

# Deployed page Paystack redirects back to after payment.
PAYSTACK_CALLBACK_URL=https://campus-food-ordering-platform.web.app/customer/order-management/payment-callback.html

# App mode.
PAYSTACK_ENV=test

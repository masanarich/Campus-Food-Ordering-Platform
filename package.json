{
  "name": "campus-food-ordering-platform",
  "version": "2.0.0",
  "description": "Campus Food Ordering Platform with Payment System",
  "scripts": {
    "test": "jest",
    "test:coverage": "jest --coverage",
    "functions:serve": "cd functions && npm run serve",
    "functions:deploy": "cd functions && npm run deploy"
  },
  "dependencies": {
    "firebase": "^12.11.0",
    "crypto": "^1.0.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0"
  },
  "jest": {
    "testEnvironment": "jsdom",
    "collectCoverageFrom": [
      "public/**/*.js",
      "!public/authentication/config.js",
      "!public/authentication/auth.js"
    ],
    "coverageDirectory": "coverage",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ]
  }
}